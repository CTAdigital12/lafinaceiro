# La Financeiro — frontend env vars
#
# All keys here are PUBLIC by design (R2): the anon JWT goes into the
# browser bundle, and the project ref/URL are also public. Never put
# the Supabase service_role key, DB password, or any secret here.
#
# Local setup: copy to .env and fill with the values from your own
# Supabase project (Settings -> API). The .env file itself is git-ignored.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
